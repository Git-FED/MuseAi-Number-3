<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/muse_cream">
    <ProgressBar android:id="@+id/progress" style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent" android:layout_height="3dp" android:max="100" android:visibility="gone" />
    <FrameLayout android:id="@+id/slot_container" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" />
    <include android:id="@+id/switcher_bar" layout="@layout/switcher_bar" />
</LinearLayout>
